// HAULIX data model (Module 1: lead generation only).
// Carrier Portal models (users, trucks, loads, documents) will be added in Module 2.
//
// One `Lead` table holds every inbound inquiry, so the team works a single
// queue with one status workflow. `type` says which form it came from.
// Which fields are required for each type is enforced by the Zod schemas in
// src/validations/lead.ts; the database only enforces what is true for all
// leads. Column lengths match the Zod limits in src/lib/validations/primitives.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Which public form created the lead.
enum LeadType {
  CARRIER_INQUIRY /// "Get Started" form (/get-started)
  CONTACT /// General contact form (/contact)
}

/// Sales workflow: NEW -> CONTACTED -> QUALIFIED -> ONBOARDED or REJECTED.
/// ONBOARDED (won) and REJECTED (lost) are the closed states.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ONBOARDED
  REJECTED
  SPAM /// Identified as spam; kept for abuse review, never worked.
}

/// Topic of a contact message. Labels live in src/content/inquiry-types.ts.
enum InquiryType {
  GENERAL
  DISPATCH_SERVICES
  PRICING
  EQUIPMENT
  PARTNERSHIP
  OTHER
}

model Lead {
  // Identity and classification
  id     String     @id @default(cuid())
  type   LeadType
  status LeadStatus @default(NEW)

  // Contact information
  fullName    String  @db.VarChar(100)
  email       String  @db.VarChar(254)
  /// Required for CARRIER_INQUIRY (validation level), optional for CONTACT.
  phone       String? @db.VarChar(30)
  companyName String? @db.VarChar(150)
  mcNumber    String? @db.VarChar(10)
  dotNumber   String? @db.VarChar(10)

  // Dispatch information (required for CARRIER_INQUIRY at validation level)
  /// Equipment slug from src/content/services.ts. A string, not an enum, so
  /// adding an equipment type never needs a migration.
  equipment      String? @db.VarChar(50)
  fleetSize      Int?
  preferredLanes String? @db.VarChar(300)

  // Inquiry information
  /// Required for CONTACT at validation level.
  inquiryType InquiryType?
  subject     String?      @db.VarChar(150)
  message     String?      @db.Text

  // Server-managed: never taken from client input
  /// Path of the page the form was submitted from.
  sourcePage         String?   @db.VarChar(500)
  /// Idempotency key: a resubmission with the same id is not stored twice.
  submissionId       String    @unique @default(cuid())
  /// Salted hash of the client IP (never the raw IP), for abuse limits.
  ipHash             String?   @db.VarChar(64)
  userAgent          String?   @db.VarChar(500)
  notifiedAt         DateTime?
  confirmationSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Administration
  /// LEGACY single notes field. Its content was copied into LeadNote by the
  /// add_admin_auth migration; new notes go to LeadNote. Kept, never dropped.
  notes       String?   @db.Text
  /// Set the first time an admin moves the lead to CONTACTED.
  contactedAt DateTime?

  leadNotes  LeadNote[]
  activities LeadActivity[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([type, status, createdAt])
  @@index([email])
  @@index([ipHash, createdAt])
}

/// Internal admin note on a lead. Several per lead, with author and timestamps.
/// authorId is null for notes imported from the legacy Lead.notes field, or when
/// the author's account was deleted.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
}

enum LeadActivityAction {
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_EDITED
  NOTE_DELETED
}

/// Audit trail of admin changes to a lead. Rows are only ever inserted.
model LeadActivity {
  id         String             @id @default(cuid())
  leadId     String
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     LeadActivityAction
  fromStatus LeadStatus?
  toStatus   LeadStatus?
  /// The note concerned (no foreign key, so history survives a deleted note).
  noteId     String?
  /// Extra detail, e.g. the previous note body for NOTE_EDITED / NOTE_DELETED.
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth, self-hosted). Field names follow Better Auth's
// schema for its core tables and the admin and twoFactor plugins
// (better-auth 1.7.16). Shared by admins now and carriers later (role column).
// ---------------------------------------------------------------------------

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// "admin" or "carrier" (see src/lib/auth-roles.ts).
  role             String?
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)

  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  leadNotes      LeadNote[]
  leadActivities LeadActivity[]

  @@index([role])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash for providerId "credential". Never returned by the API.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP secret and backup codes (stored encrypted by Better Auth).
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

/// Better Auth rate-limit counters (database storage, shared by all instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
