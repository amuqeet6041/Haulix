# ---------------------------------------------------------------------------
# HAULIX environment variables
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
# NEVER commit real credentials. Only variables prefixed NEXT_PUBLIC_ are
# exposed to the browser, so keep every secret WITHOUT that prefix.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Not required to run the public website UI. Needed only once lead storage is
# switched on. Pooled connection string used by the app at runtime.
DATABASE_URL=

# Direct (non-pooled) connection string used by Prisma migrations.
# If your host has no pooler, set this to the same value as DATABASE_URL.
DIRECT_URL=

# --- Site --------------------------------------------------------------------
# Public base URL of the site, with no trailing slash (e.g. https://example.com).
# Used for metadataBase, canonical URLs, sitemap and robots. Public on purpose.
# Left empty on purpose: set it once the production domain is decided.
# Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# --- Email (Resend) ----------------------------------------------------------
# Emails are sent in the background after a lead is saved. Missing values only
# skip email; leads are still stored. None of these may use NEXT_PUBLIC_.
#
# Server-only API key from https://resend.com.
RESEND_API_KEY=

# Sender for all lead emails, e.g. "HAULIX Logistics <dispatch@yourdomain.com>".
# Must use a domain verified in Resend. There is no built-in fallback sender.
# (The older name EMAIL_FROM is still read if FROM_EMAIL is empty.)
FROM_EMAIL=

# HAULIX inbox that receives new lead notifications. Also used as the reply-to
# address on customer confirmation emails. Required for business notifications.
CONTACT_EMAIL=

# --- Analytics (optional) ----------------------------------------------------
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Public by design.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Error monitoring (optional) --------------------------------------------
# Sentry DSN. Server-side placeholder; Sentry is not installed yet.
SENTRY_DSN=
